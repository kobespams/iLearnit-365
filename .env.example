# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# NETLIFY DEPLOYMENT SECRETS (Optional for CI/CD & Automated GitHub Actions Hosting)
# Obtain your Personal Access Token from Netlify User Settings -> Applications -> Personal Access Tokens
NETLIFY_AUTH_TOKEN="nfp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NETLIFY_API_KEY="nfp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Netlify Site API ID from Netlify Site Configuration -> General -> Site details -> API ID
NETLIFY_SITE_ID="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"

# ADMINISTRATIVE MASTER KEY (Server-Side Only — Set in Settings -> Secrets)
# Leave blank here; set your secret Master Key in AI Studio Secrets or claim it via the Admin Portal first-run setup.
ADMIN_MASTER_KEY=

# ADMINISTRATIVE TOTP SECRET (Disabled when Master Key alone mode is active)
ADMIN_TOTP_SECRET=

# SMTP EMAIL SERVER CONFIGURATION (Server-Side Only — Set in Settings -> Secrets)
# Active sender defaults to ilearnit365@gmail.com. Provide a Gmail App Password in SMTP_PASS for live delivery.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="ilearnit365@gmail.com"
SMTP_PASS=
SMTP_FROM_EMAIL="ilearnit365@gmail.com"
ADMIN_NOTIFY_EMAIL="ilearnit365@gmail.com"
